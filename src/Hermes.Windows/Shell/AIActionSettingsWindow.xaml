<Window x:Class="Hermes.Windows.Shell.AIActionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes AI Actions"
        Width="920"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="AIAction.Card" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="AIAction.Label" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="AIAction.Input" TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="AIAction.Button" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AIAction.PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AIAction.Button}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource AIAction.Button}"
                    Click="Close_Click"
                    Content="Close"/>
            <StackPanel>
                <TextBlock Text="AI Actions"
                           FontSize="22"
                           FontWeight="Medium"/>
                <TextBlock Text="Configure reusable AI shortcuts without changing the built-in translation workflow."
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource AIAction.Card}">
                        <StackPanel>
                            <TextBlock Text="DeepSeek API Configuration"
                                       FontWeight="Medium"
                                       FontSize="15"/>
                            <TextBlock Text="Shared by all AI Actions. If empty, Hermes saved API key is used as fallback."
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>

                            <TextBlock Text="API Base URL" Style="{StaticResource AIAction.Label}"/>
                            <TextBox x:Name="BaseUrlText" Style="{StaticResource AIAction.Input}"/>

                            <TextBlock Text="Model" Style="{StaticResource AIAction.Label}" Margin="0,10,0,5"/>
                            <TextBox x:Name="ModelText" Style="{StaticResource AIAction.Input}"/>

                            <TextBlock Text="Temperature" Style="{StaticResource AIAction.Label}" Margin="0,10,0,5"/>
                            <TextBox x:Name="TemperatureText" Style="{StaticResource AIAction.Input}"/>

                            <TextBlock Text="Choose File Hotkey" Style="{StaticResource AIAction.Label}" Margin="0,10,0,5"/>
                            <Button x:Name="ChooseFileHotkeyButton"
                                    Style="{StaticResource AIAction.Button}"
                                    HorizontalContentAlignment="Left"
                                    Click="ChooseFileHotkeyButton_Click"
                                    PreviewKeyDown="HotkeyRecorder_PreviewKeyDown"
                                    LostKeyboardFocus="HotkeyRecorder_LostKeyboardFocus"/>

                            <TextBlock Text="API Key" Style="{StaticResource AIAction.Label}" Margin="0,10,0,5"/>
                            <PasswordBox x:Name="ApiKeyBox"
                                         MinHeight="34"
                                         Padding="10,7"
                                         Background="{DynamicResource Brush.Surface}"
                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                         BorderBrush="{DynamicResource Brush.Border}"
                                         BorderThickness="1"/>

                            <Button Style="{StaticResource AIAction.Button}"
                                    Margin="0,12,0,0"
                                    Click="SaveConfig_Click"
                                    Content="Save AI Configuration"/>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,2,0,10">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource AIAction.PrimaryButton}"
                                Click="NewAction_Click"
                                Content="New"/>
                        <TextBlock Text="Configured Actions"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ItemsControl x:Name="ActionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AIAction.Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Hotkey, StringFormat=Hotkey: {0}}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding InputFile, StringFormat=Input file: {0}}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource AIAction.Button}"
                                                    Tag="{Binding Id}"
                                                    Click="EditAction_Click"
                                                    Content="Edit"/>
                                            <Button Style="{StaticResource AIAction.Button}"
                                                    Tag="{Binding Id}"
                                                    Margin="8,0,0,0"
                                                    Click="MoveActionUp_Click"
                                                    Content="Up"/>
                                            <Button Style="{StaticResource AIAction.Button}"
                                                    Tag="{Binding Id}"
                                                    Margin="8,0,0,0"
                                                    Click="MoveActionDown_Click"
                                                    Content="Down"/>
                                            <Button Style="{StaticResource AIAction.Button}"
                                                    Tag="{Binding Id}"
                                                    Margin="8,0,0,0"
                                                    Click="DeleteAction_Click"
                                                    Content="Delete"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource AIAction.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Action Editor"
                               FontSize="18"
                               FontWeight="Medium"/>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Name" Style="{StaticResource AIAction.Label}"/>
                            <TextBox x:Name="ActionNameText" Style="{StaticResource AIAction.Input}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hotkey" Style="{StaticResource AIAction.Label}"/>
                            <Button x:Name="ActionHotkeyButton"
                                    Style="{StaticResource AIAction.Button}"
                                    HorizontalContentAlignment="Left"
                                    ToolTip="Click, then press a combination like Ctrl+Alt+P. Backspace clears."
                                    Click="ActionHotkeyButton_Click"
                                    PreviewKeyDown="HotkeyRecorder_PreviewKeyDown"
                                    LostKeyboardFocus="HotkeyRecorder_LostKeyboardFocus"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Input file (.txt / .md)" Style="{StaticResource AIAction.Label}"/>
                            <TextBox x:Name="InputFileText" Style="{StaticResource AIAction.Input}" IsReadOnly="True"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource AIAction.Button}"
                                Margin="10,21,0,0"
                                Click="ChooseInputFile_Click"
                                Content="Choose File"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,8">
                        <TextBlock Text="Variables:"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" $text$  $clipboard$  $file_input$  $file_append$  $file_overwrite$"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   FontWeight="Medium"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <RichTextBox x:Name="PromptEditor"
                                 Grid.Row="4"
                                 MinHeight="180"
                                 Padding="10"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource Brush.Surface}"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 TextChanged="PromptEditor_TextChanged"/>

                    <DockPanel Grid.Row="5" Margin="0,14,0,0">
                        <TextBlock x:Name="EditorStatusText"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource AIAction.Button}"
                                    Click="ClearEditor_Click"
                                    Content="Clear"/>
                            <Button Style="{StaticResource AIAction.PrimaryButton}"
                                    Margin="10,0,0,0"
                                    Click="SaveAction_Click"
                                    Content="Save Action"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>




